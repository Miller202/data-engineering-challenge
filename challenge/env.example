# Copie para .env e ajuste se necessário (cp .env.example .env).
# No Linux, use o seu UID para evitar problemas de permissão na pasta logs/: echo "AIRFLOW_UID=$(id -u)"
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.11
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Banco de dados do desafio (camadas raw, trusted e refined)
DW_USER=nyc
DW_PASSWORD=nyc
DW_DB=nyc_taxi
DW_PORT=5433
